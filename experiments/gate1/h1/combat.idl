interface CombatHost {
    opaque CombatResource;
    struct Vec2 { x: i32; y: i32; }
    struct EnemyView { id: i32; health: i32; name: string; position: Vec2; }
    enum CombatError { MissingEntity, InvalidAmount, Busy, Cancelled }
    enum CombatEvent { Idle, Damage(i32), Moved(Vec2) }

    sync fuel 1 fn apply_damage(entity: i32, amount: i32) -> Result<i32, CombatError>;
    sync fuel 1 fn heal(entity: i32, amount: i32) -> Result<i32, CombatError>;
    sync fuel 2 fn entity_name(entity: i32) -> string;
    sync fuel 2 fn enemy_view(entity: i32) -> EnemyView;
    sync fuel 2 fn combat_event(entity: i32) -> CombatEvent;
    sync fuel 2 fn maybe_target(entity: i32) -> Option<EnemyView>;
    sync fuel 2 fn nearby(entity: i32) -> array<i32>;
    sync fuel 2 fn path(entity: i32) -> buffer<Vec2>;
    sync fuel 1 fn set_position(entity: i32, position: Vec2) -> bool;
    sync fuel 1 fn set_targets(entity: i32, targets: array<i32>) -> i32;
    sync fuel 1 fn upload_path(entity: i32, points: buffer<Vec2>) -> i32;
    sync fuel 1 fn action_lock(entity: i32) -> token<CombatResource>;
    sync fuel 1 fn world_snapshot() -> snapshot<EnemyView>;
    request(return_error, trap) fn play_animation(entity: i32, clip: string)
        -> request<Result<i32, CombatError>>;
    request(cancel_task, return_error) fn query_path(entity: i32, target: Vec2)
        -> request<Result<buffer<Vec2>, CombatError>>;
    sync fuel 1 fn score(entity: i32) -> i64;
    sync fuel 1 fn set_enabled(entity: i32, enabled: bool) -> bool;
    sync fuel 1 fn ratio(entity: i32) -> f64;
    sync fuel 1 fn clear_target(entity: i32) -> Option<i32>;
    sync fuel 1 fn inspect_events(events: array<CombatEvent>) -> Result<i32, CombatError>;
}
