{
  "schema_version": 1,
  "projection": "gate1-v2.7-h2-semantic-v1",
  "canonicalization": {
    "encoding": "canonical-serde-json",
    "object_order": "lexicographic",
    "array_order": "scenario-manifest-order",
    "missing_field": "INVALID",
    "numeric_policy": "semantic-fields-must-be-integers",
    "unknown_field": "ignored"
  },
  "required_sections": {
    "production_cases": 32,
    "scenarios": 32,
    "cleanup": 12
  },
  "scenario_fields": [
    "scenario_id",
    "scenario_spec_hash",
    "configuration_dimensions",
    "expected_task_count",
    "observed_task_count",
    "expected_promotion_count",
    "observed_promotion_count",
    "host_call_count",
    "trace_event_count",
    "complex_value_count",
    "execution_fingerprint",
    "production",
    "cohorts",
    "invariant_violation_kinds"
  ],
  "production_fields": [
    "calls_per_frame",
    "completed",
    "complex_types",
    "complex_value_count",
    "expected_calls",
    "expected_promotions",
    "first_slice_target_percent",
    "host_call",
    "host_call_count",
    "module_fingerprint",
    "observed_calls",
    "observed_first_slice",
    "observed_promotions",
    "peak_resources",
    "promotion_target_percent",
    "trace",
    "trace_event_count"
  ],
  "forbidden_fields": [
    "elapsed_ns",
    "throughput_calls_per_second",
    "mean_ns",
    "p50_ns",
    "p90_ns",
    "p95_ns",
    "p99_ns",
    "min_ns",
    "max_ns",
    "standard_deviation_ns",
    "coefficient_of_variation",
    "frame_1000_calls_ns",
    "wall_clock_timestamp",
    "monotonic_timestamp",
    "pid",
    "parent_pid",
    "process_nonce",
    "one_time_token",
    "temporary_path",
    "worktree",
    "output_directory",
    "absolute_path",
    "event_sequence",
    "event_write_time",
    "event_log_hash",
    "process_attestation_hash",
    "run_id",
    "provenance"
  ]
}
