pub fn array_new_and_push() -> i32 {
    let values: Array<i32> = Array::new();
    values.push(10);
    values.push(20);
    values.push(30);
    return values.len();
}

pub fn array_get() -> i32 {
    let values: Array<i32> = Array::new();
    values.push(42);
    return values.get(0).unwrap_or(0);
}

pub fn array_pop() -> i32 {
    let values: Array<i32> = Array::new();
    values.push(1);
    values.push(2);
    return values.pop();
}

pub fn array_is_empty() -> bool {
    let values: Array<i32> = Array::new();
    return values.is_empty();
}

pub fn array_clear() -> bool {
    let values: Array<i32> = Array::new();
    values.push(1);
    return values.clear();
}

pub fn array_capacity_and_reserve() -> i32 {
    let values: Array<i32> = Array::new();
    values.reserve(10);
    return values.capacity();
}

pub fn array_shrink_to_fit() -> bool {
    let values: Array<i32> = Array::new();
    values.push(1);
    values.shrink_to_fit();
    return values.len() == 1;
}

pub fn array_first_and_last() -> i32 {
    let values: Array<i32> = Array::new();
    values.push(10);
    values.push(20);
    return values.first().unwrap_or(0) + values.last().unwrap_or(0);
}

pub fn array_swap() -> bool {
    let values: Array<i32> = Array::new();
    values.push(1);
    values.push(2);
    return values.swap(0, 1);
}

pub fn array_reverse() -> bool {
    let values: Array<i32> = Array::new();
    values.push(1);
    values.push(2);
    return values.reverse();
}

pub fn array_for_iteration() -> i32 {
    let values: Array<i32> = Array::new();
    values.push(10);
    values.push(20);
    values.push(30);
    let total: i32 = 0;
    for item in values {
        total = total + item;
    }
    return total;
}

pub fn mutable_parameter(value: i32) -> i32 {
    while value > 0 {
        value -= 1;
    }
    return value;
}
