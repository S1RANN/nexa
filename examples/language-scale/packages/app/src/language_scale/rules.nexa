use scale_common::math as math;

/// This identity stays explicit if the declaration moves.
@stable("language-scale.base-score")
pub const BASE_SCORE: i32 = 10;

/* Consumers of this Package cannot call normalize directly. */
pub(package) fn normalize(value: i32) -> i32 {
    return math::twice(value);
}

fn add_base(value: i32) -> i32 {
    return value + BASE_SCORE;
}

pub(package) fn score(value: i32) -> i32 {
    return add_base(normalize(value));
}
