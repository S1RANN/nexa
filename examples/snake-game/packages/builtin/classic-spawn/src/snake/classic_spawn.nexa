module snake.classic_spawn;
import host as snake;
import std.collections as collections;

fn empty() -> Array<snake.SnakeCommand> {
    return [];
}

fn register() -> Array<snake.SnakeCommand> {
    let commands: Array<snake.SnakeCommand> = [];
    collections.array_push(commands, snake.RegisterSpawnPolicy("classic"));
    return commands;
}

fn propose(snapshot: snake.GameSnapshot) -> Array<snake.SnakeCommand> {
    let commands: Array<snake.SnakeCommand> = [];
    let cell: snake.Cell = snake.Cell { x: snapshot.width / 2, y: snapshot.height / 2 };
    collections.array_push(commands, snake.ProposeFoodSpawn(cell));
    return commands;
}

pub fn OnEvent(event: snake.SnakeEvent) -> Array<snake.SnakeCommand> {
    return match event {
        snake.PackageEnabled(snapshot) => register(),
        snake.GameStarted(snapshot) => empty(),
        snake.GameTick(snapshot) => empty(),
        snake.ScoreChanged(snapshot) => empty(),
        snake.FoodSpawnRequested(snapshot) => propose(snapshot),
        snake.FoodEaten(snapshot) => empty(),
        snake.GameEnded(snapshot) => empty(),
        snake.SettingsChanged(snapshot) => empty(),
    };
}
