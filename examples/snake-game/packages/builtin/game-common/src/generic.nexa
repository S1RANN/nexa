pub struct Pair<T, U> {
    first: T,
    second: U,
}

pub struct Holder<T> {
    value: T,
}

impl<T> Holder<T> {
    pub fn get(self) -> T {
        return self.value;
    }
}

pub enum Change<T> {
    Unchanged,
    Updated(T),
}

pub fn identity<T>(value: T) -> T {
    return value;
}

pub fn contains<T: PartialEq>(values: Array<T>, expected: T) -> bool {
    for value in values {
        if value == expected {
            return true;
        }
    }
    return false;
}
