module snake.classic_hud;
import snake;

fn empty() -> Array<SnakeCommand> {
    return Array.new<SnakeCommand>();
}

fn register() -> Array<SnakeCommand> {
    let commands: Array<SnakeCommand> = Array.new<SnakeCommand>();
    commands.push(RegisterWidget("score"));
    return commands;
}

fn update(snapshot: GameSnapshot) -> Array<SnakeCommand> {
    let commands: Array<SnakeCommand> = Array.new<SnakeCommand>();
    let stats: GameStats = snapshot.stats;
    let text: string = snake.format_score(stats.score);
    commands.push(SetWidgetText(WidgetText { local_id: "score", text: text }));
    return commands;
}

fn OnEvent(event: SnakeEvent) -> Array<SnakeCommand> {
    return match event {
        PackageEnabled(snapshot) => register(),
        GameStarted(snapshot) => empty(),
        GameTick(snapshot) => update(snapshot),
        ScoreChanged(snapshot) => update(snapshot),
        FoodSpawnRequested(snapshot) => empty(),
        FoodEaten(snapshot) => empty(),
        GameEnded(snapshot) => empty(),
        SettingsChanged(snapshot) => empty(),
    };
}
