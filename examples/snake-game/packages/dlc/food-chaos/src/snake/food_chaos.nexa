use host::snake;

fn empty() -> Array<snake::SnakeCommand> {
    return Array::new();
}

fn register() -> Array<snake::SnakeCommand> {
    return [
        snake::SnakeCommand::RegisterFood(snake::FoodDefinition { local_id: "golden", length_delta: 2, score_delta: 20, speed_delta: 0 }),
        snake::SnakeCommand::RegisterFood(snake::FoodDefinition { local_id: "poison", length_delta: 0 - 1, score_delta: 0, speed_delta: 0 }),
        snake::SnakeCommand::RegisterFood(snake::FoodDefinition { local_id: "speed", length_delta: 0, score_delta: 0, speed_delta: 0 - 20 }),
    ];
}

pub fn calculate_food_effect(
    context: snake::FoodEatenContext,
) -> snake::FoodEffect {
    let kind: string = context.food.kind;
    if kind == "official.food-chaos:golden" {
        return snake::FoodEffect {
            length_delta: 2,
            score_delta: 20,
            speed_delta: 0,
        };
    }
    if kind == "official.food-chaos:poison" {
        return snake::FoodEffect {
            length_delta: 0 - 1,
            score_delta: 0,
            speed_delta: 0,
        };
    }
    if kind == "official.food-chaos:speed" {
        return snake::FoodEffect {
            length_delta: 0,
            score_delta: 0,
            speed_delta: 0 - 20,
        };
    }
    return snake::FoodEffect {
        length_delta: 0,
        score_delta: 0,
        speed_delta: 0,
    };
}

pub fn on_event(event: snake::SnakeEvent) -> Array<snake::SnakeCommand> {
    return match event {
        snake::SnakeEvent::PackageEnabled(snapshot) => register(),
        snake::SnakeEvent::GameStarted(snapshot) => empty(),
        snake::SnakeEvent::GameTick(snapshot) => empty(),
        snake::SnakeEvent::ScoreChanged(snapshot) => empty(),
        snake::SnakeEvent::FoodSpawnRequested(snapshot) => empty(),
        snake::SnakeEvent::FoodEaten(snapshot) => empty(),
        snake::SnakeEvent::GameEnded(snapshot) => empty(),
        snake::SnakeEvent::SettingsChanged(snapshot) => empty(),
    };
}
