module snake.food_chaos;
import snake;

fn empty() -> Array<SnakeCommand> {
    return Array.new<SnakeCommand>();
}

fn register() -> Array<SnakeCommand> {
    let commands: Array<SnakeCommand> = Array.new<SnakeCommand>();
    commands.push(RegisterFood(FoodDefinition { local_id: "golden", length_delta: 2, score_delta: 20, speed_delta: 0 }));
    commands.push(RegisterFood(FoodDefinition { local_id: "poison", length_delta: 0 - 1, score_delta: 0, speed_delta: 0 }));
    commands.push(RegisterFood(FoodDefinition { local_id: "speed", length_delta: 0, score_delta: 0, speed_delta: 0 - 20 }));
    return commands;
}

fn effect(snapshot: GameSnapshot) -> Array<SnakeCommand> {
    let commands: Array<SnakeCommand> = Array.new<SnakeCommand>();
    let kind: string = match snapshot.food {
        Some(food) => food.kind,
        None => "classic",
    };
    if kind == "official.food-chaos:golden" {
        commands.push(ResizeSnake(2));
        commands.push(AddScore(20));
    }
    if kind == "official.food-chaos:poison" {
        commands.push(ResizeSnake(0 - 1));
    }
    if kind == "official.food-chaos:speed" {
        commands.push(SetSpeed(0 - 20));
    }
    return commands;
}

fn OnEvent(event: SnakeEvent) -> Array<SnakeCommand> {
    return match event {
        PackageEnabled(snapshot) => register(),
        GameStarted(snapshot) => empty(),
        GameTick(snapshot) => empty(),
        ScoreChanged(snapshot) => empty(),
        FoodSpawnRequested(snapshot) => empty(),
        FoodEaten(snapshot) => effect(snapshot),
        GameEnded(snapshot) => empty(),
        SettingsChanged(snapshot) => empty(),
    };
}
