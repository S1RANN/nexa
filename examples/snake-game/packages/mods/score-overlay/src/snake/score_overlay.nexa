
@state(version = 1)
class OverlayState {
    foods: i32,
}

fn empty() -> Array<host::SnakeCommand> {
    return Array::new();
}

fn register() -> Array<host::SnakeCommand> {
    return [host::SnakeCommand::RegisterWidget("stats")];
}

fn update(snapshot: host::GameSnapshot) -> Array<host::SnakeCommand> {
    let stats: host::GameStats = snapshot.stats;
    let text: string = host::format_stats(stats.score, stats.total_plays, stats.foods);
    return [host::SnakeCommand::SetWidgetText(host::WidgetText { local_id: "stats", text: text })];
}

pub fn on_event(event: host::SnakeEvent) -> Array<host::SnakeCommand> {
    return match event {
        host::SnakeEvent::PackageEnabled(snapshot) => register(),
        host::SnakeEvent::GameStarted(snapshot) => empty(),
        host::SnakeEvent::GameTick(snapshot) => update(snapshot),
        host::SnakeEvent::ScoreChanged(snapshot) => update(snapshot),
        host::SnakeEvent::FoodSpawnRequested(snapshot) => empty(),
        host::SnakeEvent::FoodEaten(snapshot) => empty(),
        host::SnakeEvent::GameEnded(snapshot) => empty(),
        host::SnakeEvent::SettingsChanged(snapshot) => update(snapshot),
    };
}
