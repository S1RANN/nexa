use host::snake;

@state(version = 1)
class OverlayState {
    mut foods: i32,
}

fn empty() -> Array<snake::SnakeCommand> {
    return Array::new();
}

fn register() -> Array<snake::SnakeCommand> {
    return [snake::SnakeCommand::RegisterWidget("stats")];
}

fn update(snapshot: snake::GameSnapshot) -> Array<snake::SnakeCommand> {
    let stats: snake::GameStats = snapshot.stats;
    let text: string = snake::format_stats(stats.score, stats.total_plays, stats.foods);
    return [snake::SnakeCommand::SetWidgetText(snake::WidgetText { local_id: "stats", text: text })];
}

pub fn on_event(event: snake::SnakeEvent) -> Array<snake::SnakeCommand> {
    return match event {
        snake::SnakeEvent::PackageEnabled(snapshot) => register(),
        snake::SnakeEvent::GameStarted(snapshot) => empty(),
        snake::SnakeEvent::GameTick(snapshot) => update(snapshot),
        snake::SnakeEvent::ScoreChanged(snapshot) => update(snapshot),
        snake::SnakeEvent::FoodSpawnRequested(snapshot) => empty(),
        snake::SnakeEvent::FoodEaten(snapshot) => empty(),
        snake::SnakeEvent::GameEnded(snapshot) => empty(),
        snake::SnakeEvent::SettingsChanged(snapshot) => update(snapshot),
    };
}
