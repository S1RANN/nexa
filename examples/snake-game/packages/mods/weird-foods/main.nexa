module snake.weird_foods;
import snake;

fn empty() -> Array<SnakeCommand> {
    return Array.new<SnakeCommand>();
}

fn register() -> Array<SnakeCommand> {
    let commands: Array<SnakeCommand> = Array.new<SnakeCommand>();
    commands.push(RegisterFood(FoodDefinition { local_id: "shrink", length_delta: 0 - 1, score_delta: 0, speed_delta: 0 }));
    commands.push(RegisterFood(FoodDefinition { local_id: "double", length_delta: 2, score_delta: 0, speed_delta: 0 }));
    commands.push(RegisterFood(FoodDefinition { local_id: "score-bomb", length_delta: 0, score_delta: 50, speed_delta: 0 }));
    return commands;
}

fn effect(snapshot: GameSnapshot) -> Array<SnakeCommand> {
    let commands: Array<SnakeCommand> = Array.new<SnakeCommand>();
    let kind: string = match snapshot.food {
        Some(food) => food.kind,
        None => "classic",
    };
    if kind == "community.weird-foods:shrink" {
        commands.push(ResizeSnake(0 - 1));
    }
    if kind == "community.weird-foods:double" {
        commands.push(ResizeSnake(2));
    }
    if kind == "community.weird-foods:score-bomb" {
        commands.push(AddScore(50));
    }
    return commands;
}

fn OnEvent(event: SnakeEvent) -> Array<SnakeCommand> {
    return match event {
        PackageEnabled(snapshot) => register(),
        GameStarted(snapshot) => empty(),
        GameTick(snapshot) => empty(),
        ScoreChanged(snapshot) => empty(),
        FoodSpawnRequested(snapshot) => empty(),
        FoodEaten(snapshot) => effect(snapshot),
        GameEnded(snapshot) => empty(),
        SettingsChanged(snapshot) => empty(),
    };
}
