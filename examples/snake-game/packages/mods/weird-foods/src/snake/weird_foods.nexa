use host::snake;

fn empty() -> Array<snake::SnakeCommand> {
    return Array::new();
}

fn register() -> Array<snake::SnakeCommand> {
    return [
        snake::SnakeCommand::RegisterFood(snake::FoodDefinition { local_id: "shrink", length_delta: 0 - 1, score_delta: 0, speed_delta: 0 }),
        snake::SnakeCommand::RegisterFood(snake::FoodDefinition { local_id: "double", length_delta: 2, score_delta: 0, speed_delta: 0 }),
        snake::SnakeCommand::RegisterFood(snake::FoodDefinition { local_id: "score-bomb", length_delta: 0, score_delta: 50, speed_delta: 0 }),
    ];
}

pub fn calculate_food_effect(
    context: snake::FoodEatenContext,
) -> snake::FoodEffect {
    let kind: string = context.food.kind;
    if kind == "community.weird-foods:shrink" {
        return snake::FoodEffect {
            length_delta: 0 - 1,
            score_delta: 0,
            speed_delta: 0,
        };
    }
    if kind == "community.weird-foods:double" {
        return snake::FoodEffect {
            length_delta: 2,
            score_delta: 0,
            speed_delta: 0,
        };
    }
    if kind == "community.weird-foods:score-bomb" {
        return snake::FoodEffect {
            length_delta: 0,
            score_delta: 50,
            speed_delta: 0,
        };
    }
    return snake::FoodEffect {
        length_delta: 0,
        score_delta: 0,
        speed_delta: 0,
    };
}

pub fn on_event(event: snake::SnakeEvent) -> Array<snake::SnakeCommand> {
    return match event {
        snake::SnakeEvent::PackageEnabled(snapshot) => register(),
        snake::SnakeEvent::GameStarted(snapshot) => empty(),
        snake::SnakeEvent::GameTick(snapshot) => empty(),
        snake::SnakeEvent::ScoreChanged(snapshot) => empty(),
        snake::SnakeEvent::FoodSpawnRequested(snapshot) => empty(),
        snake::SnakeEvent::FoodEaten(snapshot) => empty(),
        snake::SnakeEvent::GameEnded(snapshot) => empty(),
        snake::SnakeEvent::SettingsChanged(snapshot) => empty(),
    };
}
