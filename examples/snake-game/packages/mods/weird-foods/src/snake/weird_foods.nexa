
fn empty() -> Array<host::SnakeCommand> {
    return Array::new();
}

fn register() -> Array<host::SnakeCommand> {
    return [
        host::SnakeCommand::RegisterFood(host::FoodDefinition { local_id: "shrink", length_delta: 0 - 1, score_delta: 0, speed_delta: 0 }),
        host::SnakeCommand::RegisterFood(host::FoodDefinition { local_id: "double", length_delta: 2, score_delta: 0, speed_delta: 0 }),
        host::SnakeCommand::RegisterFood(host::FoodDefinition { local_id: "score-bomb", length_delta: 0, score_delta: 50, speed_delta: 0 }),
    ];
}

pub fn calculate_food_effect(
    context: host::FoodEatenContext,
) -> host::FoodEffect {
    let kind: string = context.food.kind;
    if kind == "community.weird-foods:shrink" {
        return host::FoodEffect {
            length_delta: 0 - 1,
            score_delta: 0,
            speed_delta: 0,
        };
    }
    if kind == "community.weird-foods:double" {
        return host::FoodEffect {
            length_delta: 2,
            score_delta: 0,
            speed_delta: 0,
        };
    }
    if kind == "community.weird-foods:score-bomb" {
        return host::FoodEffect {
            length_delta: 0,
            score_delta: 50,
            speed_delta: 0,
        };
    }
    return host::FoodEffect {
        length_delta: 0,
        score_delta: 0,
        speed_delta: 0,
    };
}

pub fn on_event(event: host::SnakeEvent) -> Array<host::SnakeCommand> {
    return match event {
        host::SnakeEvent::PackageEnabled(snapshot) => register(),
        host::SnakeEvent::GameStarted(snapshot) => empty(),
        host::SnakeEvent::GameTick(snapshot) => empty(),
        host::SnakeEvent::ScoreChanged(snapshot) => empty(),
        host::SnakeEvent::FoodSpawnRequested(snapshot) => empty(),
        host::SnakeEvent::FoodEaten(snapshot) => empty(),
        host::SnakeEvent::GameEnded(snapshot) => empty(),
        host::SnakeEvent::SettingsChanged(snapshot) => empty(),
    };
}
