use host::snake;

fn empty() -> Array<snake::SnakeCommand> {
    return Array::new();
}

fn register() -> Array<snake::SnakeCommand> {
    return [snake::SnakeCommand::RegisterSkin("neon")];
}

pub fn on_event(event: snake::SnakeEvent) -> Array<snake::SnakeCommand> {
    return match event {
        snake::SnakeEvent::PackageEnabled(snapshot) => register(),
        snake::SnakeEvent::GameStarted(snapshot) => empty(),
        snake::SnakeEvent::GameTick(snapshot) => empty(),
        snake::SnakeEvent::ScoreChanged(snapshot) => empty(),
        snake::SnakeEvent::FoodSpawnRequested(snapshot) => empty(),
        snake::SnakeEvent::FoodEaten(snapshot) => empty(),
        snake::SnakeEvent::GameEnded(snapshot) => empty(),
        snake::SnakeEvent::SettingsChanged(snapshot) => empty(),
    };
}
