
use game_common::generic as common;

@state(version = 1)
class EnemyBrain {
    phase: i32,
    legacy_target: i32,
}

@state(version = 1)
class StableBrain {
    phase: i32,
}

struct CombatStats {
    damage: i64,
    label: string,
}

impl CombatStats {
    fn total(self, bonus: i64) -> i64 {
        return self.damage + bonus;
    }

    fn with_damage(self, damage: i64) -> Self {
        return CombatStats { damage: damage, label: self.label };
    }
}

enum CombatEvent {
    Idle,
    Damage(CombatStats),
}

impl CombatEvent {
    fn damage(self) -> i64 {
        return match self {
            CombatEvent::Idle => 0,
            CombatEvent::Damage(stats) => stats.total(0),
        };
    }
}

class CombatFrame {
    hits: i32,
    next: Option<CombatFrame>,
}

impl CombatFrame {
    fn record_hit(self) {
        self.hits += 1;
    }
}

fn option_value(value: i32) -> i32 {
    let target: Option<i32> = Option::Some(value);
    return match target {
        Option::Some(found) => found,
        Option::None => 0,
    };
}

fn no_target() -> Option<i32> {
    return Option::None;
}

pub async fn animation_checked(value: i32) -> Result<i32, host::AnimationError> {
    let completed: i32 = host::animation(value).await?;
    return Result::Ok(completed);
}

pub async fn update(value: i32) -> i32 {
    let lock = host::action_lock(value);
    let snapshot = host::world_snapshot();
    let animation: Result<i32, host::AnimationError> = host::animation(value).await;
    let completed: i32 = match animation {
        Result::Ok(result) => result,
        Result::Err(error) => 0,
    };
    return host::update(value, 1);
}

pub fn feature_probe(input: Buffer<i32>) -> i32 {
    let wide: i64 = 9223372036854775806 + 1;
    let ratio: f32 = 7.5 / 2.5;
    let glyph: rune = '界';
    let label: string = "combat" + "-runtime";
    let stats: CombatStats = CombatStats { damage: 0, label: label }.with_damage(wide);
    let event: CombatEvent = CombatEvent::Damage(stats);
    let decoded: i64 = event.damage();

    let frame: CombatFrame = CombatFrame { hits: 1, next: Option::None };
    frame.record_hit();

    let values: Array<i32> = Array::new();
    values.push(frame.hits);
    values.push(3);

    let lookup: Map<i32, string> = Map::new();
    lookup.set(1, "ready");
    let mapped: Option<string> = lookup.get(1);
    let mapped_length: i32 = match mapped {
        Option::Some(value) => value.byte_len(),
        Option::None => 0,
    };

    input.set(0, values.get(0).unwrap_or(0));
    let copied: Buffer<i32> = input.slice(0, 2);
    input.copy(copied, 0, 1, 1);

    let optional: Option<i32> = Option::Some(input.get(1));
    let result: Result<i32, host::AnimationError> = match optional {
        Option::Some(value) => Result::Ok(value),
        Option::None => Result::Err(host::AnimationError::MissingClip),
    };
    let amount: i32 = match result {
        Result::Ok(value) => value,
        Result::Err(error) => 0,
    };
    let sample = common::Holder { value: common::identity(amount) };
    return sample.get() + mapped_length + values.len();
}

fn state_probe(handle: StateHandle<EnemyBrain>) -> i32 {
    let resolved: Result<EnemyBrain, StateHandleError> = handle.resolve();
    let alive: bool = handle.is_alive();
    let stable_value: StableId = handle.stable_id();
    let generation: i32 = handle.generation();
    return handle.hash();
}
