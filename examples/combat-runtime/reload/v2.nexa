@state(version = 2)
class EnemyBrain {
    mut phase: i32,
    mut aggression: i32,
}
@state(version = 1)
class StableBrain {
    mut phase: i32,
}
@migration
pub fn migrate(value: i32) -> i32 {
    let old_brain: EnemyBrain = old.get(boss);
    let phase: i32 = old.field(old_brain, EnemyBrain::phase);
    let brain: EnemyBrain = new.create(boss);
    new.set(brain, EnemyBrain::phase, phase);
    new.set(brain, EnemyBrain::aggression, 0);
    replace(boss, brain);
    preserve(preserved);
    delete(deleted);
    finish_migration();
    return value;
}
fn identity(value: i32) -> i32 { return value; }
pub async fn update(value: i32) -> i32 { return value + 1; }
@activation
pub fn activate(value: i32) -> i32 { return value; }
