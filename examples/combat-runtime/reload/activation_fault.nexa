module game.combat;

@stateful(2) class EnemyBrain {
    phase: i32;
    aggression: i32;
}
@stateful(1) class StableBrain {
    phase: i32;
}
pub migration fn migrate(value: i32) -> i32 {
    finish_migration();
    return value;
}
pub task fn Update(value: i32) -> i32 { return value; }
@activation
pub fn Activate(value: i32) -> i32 { return value; }
