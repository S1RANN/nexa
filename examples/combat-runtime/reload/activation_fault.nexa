@state(version = 2)
class EnemyBrain {
    phase: i32,
    aggression: i32,
}
@state(version = 1)
class StableBrain {
    phase: i32,
}
@migration
pub fn migrate(value: i32) -> i32 {
    finish_migration();
    return value;
}
pub async fn update(value: i32) -> i32 { return value; }
@activation
pub fn activate(value: i32) -> i32 { return value; }
