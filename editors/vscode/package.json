{
  "name": "nexa-language-support",
  "displayName": "Nexa Language Support",
  "description": "Syntax highlighting, structural editing, and diagnostics for Nexa v2 and NIDL v2.",
  "version": "0.2.0",
  "publisher": "s1rann",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/S1RANN/nexa.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nexa",
    "onLanguage:nexa-idl",
    "onCommand:nexa.restartLanguageServer"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nexa",
    "nidl",
    "language",
    "syntax"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nexa.restartLanguageServer",
        "title": "Nexa: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Nexa",
      "properties": {
        "nexa.server.path": {
          "type": "string",
          "default": "nexa",
          "description": "Path to the Nexa CLI executable used to run `nexa lsp`."
        }
      }
    },
    "languages": [
      {
        "id": "nexa",
        "aliases": [
          "Nexa",
          "nexa"
        ],
        "extensions": [
          ".nexa"
        ],
        "configuration": "./language-configuration/nexa.json"
      },
      {
        "id": "nexa-idl",
        "aliases": [
          "Nexa IDL",
          "NIDL",
          "nidl"
        ],
        "extensions": [
          ".nidl"
        ],
        "configuration": "./language-configuration/nexa-idl.json"
      }
    ],
    "grammars": [
      {
        "language": "nexa",
        "scopeName": "source.nexa",
        "path": "./syntaxes/nexa.tmLanguage.json"
      },
      {
        "language": "nexa-idl",
        "scopeName": "source.nexa-idl",
        "path": "./syntaxes/nexa-idl.tmLanguage.json"
      }
    ]
  }
}
