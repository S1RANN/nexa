{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "fileTypes": [
    "nexa"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#runes"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#type-names"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.nexa",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nexa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nexa",
          "match": "\\\\(?:[nrt\\\\\"]|\\$\\{)"
        },
        {
          "name": "meta.interpolation.nexa",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.nexa"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.nexa"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "runes": {
      "name": "string.quoted.single.nexa",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nexa",
          "match": "\\\\[nrt\\\\']"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexa",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.nexa",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "attributes": {
      "match": "(@)(state|fuel|migration|activation|cleanup|immediate|stable|test)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.annotation.nexa"
        },
        "2": {
          "name": "entity.name.tag.nexa"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)+)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.namespace.nexa"
            },
            "2": {
              "name": "entity.name.namespace.nexa"
            },
            "3": {
              "name": "keyword.control.namespace.nexa"
            },
            "4": {
              "name": "entity.name.namespace.nexa"
            }
          }
        },
        {
          "match": "\\b(struct|enum|class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.nexa"
            },
            "2": {
              "name": "entity.name.type.nexa"
            }
          }
        },
        {
          "match": "\\b(?:(async)\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.async.nexa"
            },
            "2": {
              "name": "storage.type.function.nexa"
            },
            "3": {
              "name": "entity.name.function.nexa"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.nexa"
            },
            "2": {
              "name": "constant.other.nexa"
            }
          }
        }
      ]
    },
    "intrinsics": {
      "name": "support.function.builtin.nexa",
      "match": "\\b(?:old\\.get|old\\.field|new\\.create|new\\.set|preserve|replace|delete|finish_migration)\\b"
    },
    "constructors": {
      "name": "entity.name.type.variant.nexa",
      "match": "\\b(?:Some|None|Ok|Err)\\b"
    },
    "builtin-types": {
      "name": "support.type.builtin.nexa",
      "match": "\\b(?:i32|i64|f32|f64|bool|rune|string|Array|Map|Set|Buffer|Option|Result|Token|Snapshot|StateHandle)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nexa",
          "match": "\\b(?:use|as|fn|struct|enum|class|impl|const|where|pub|package|async|return|let|if|else|while|match|await|yield|defer|for|in|break|continue)\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "function-calls": {
      "name": "entity.name.function.call.nexa",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:(?:::|\\.)[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*(?:<[^;{}()]+>)?\\s*\\()"
    },
    "properties": {
      "name": "variable.other.property.nexa",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
    },
    "type-names": {
      "name": "entity.name.type.nexa",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.nexa",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.nexa",
          "match": "::|&&|\\|\\||==|!=|<=|>=|\\.\\.|[+*/=!<>?:@-]"
        }
      ]
    },
    "punctuation": {
      "name": "punctuation.separator.nexa",
      "match": "[{},();,.]"
    }
  }
}
