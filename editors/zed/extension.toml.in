id = "nexa"
name = "Nexa"
version = "0.2.0"
schema_version = 1
authors = ["Nexa Contributors"]
description = "Syntax highlighting, outlines, and diagnostics for Nexa v2 and Host Contracts."
repository = "https://github.com/S1RANN/nexa"
languages = ["languages/nexa", "languages/nexa-contract"]

[grammars.nexa]
repository = "{{GRAMMAR_REPOSITORY}}"
rev = "{{GRAMMAR_REVISION}}"

[grammars.nexa_idl]
repository = "{{IDL_GRAMMAR_REPOSITORY}}"
rev = "{{IDL_GRAMMAR_REVISION}}"

[language_servers.nexa]
name = "Nexa Language Server"
languages = ["Nexa", "Nexa Contract"]

[language_servers.nexa.language_ids]
"Nexa" = "nexa"
"Nexa Contract" = "nexa-contract"
