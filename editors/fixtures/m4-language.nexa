/// Public score rules used by the game package.
use package::demo::food;
use snake_common::score as score;

// Public constants participate in the package API fingerprint.
pub const MAX_SCORE: i32 = 100;

/* Block comments are deliberately non-nested. */
@stable("score-policy")
pub(package) struct ScorePolicy {
    @stable("score-policy.multiplier")
    multiplier: i32,
}

@state(version = 2)
pub class PlayState {
    @stable("play-state.total-games")
    total_games: i32,
}

fn advance(value: i32) -> i32 {
    value += 1;
    return value;
}

@test
fn score_is_positive() -> bool {
    for value in 0..3 {
        if value == 1 {
            continue;
        }
        break;
    }

    let scores: Array<i32> = Array::new();
    scores.push(10);
    for item in scores {
        let _ = item;
    }

    let map: Map<string, i32> = Map::new();
    for (key, count) in map {
        let _ = key;
        let _ = count;
    }

    let seen: Set<i32> = Set::new();
    seen.insert(1);
    for element in seen {
        let _ = element;
    }

    let escaped: string = "literal \${score}";
    let rendered: string = "score ${MAX_SCORE}";
    return true;
}

@activation
pub async fn activate(value: i32) -> i32 {
    return host::update(value, MAX_SCORE);
}
