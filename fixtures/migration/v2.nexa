@state(version = 2)
class FixtureState {
    mut value: i32,
    mut total: i32,
}

@migration
pub fn migrate() -> bool {
    let old_state: FixtureState = old.get(fixture);
    let value: i32 = old.field(old_state, FixtureState::value);
    let state: FixtureState = new.create(fixture);
    new.set(state, FixtureState::value, value);
    new.set(state, FixtureState::total, 1);
    replace(fixture, state);
    finish_migration();
    return true;
}

async fn update(value: i32) -> i32 {
    return value + 1;
}

@activation
pub fn activate() -> bool {
    return true;
}
