interface AllocationMatrixHost {
    struct Record {
        label: string;
        value: i32;
    }

    enum Event {
        Empty,
        Record(Record)
    }

    struct Nested {
        records: array<Record>;
        samples: buffer<i32>;
        label: string;
    }

    sync fn inspect(
        name: string,
        record: Record,
        event: Event,
        option: Option<Record>,
        result: Result<Record, Event>,
        array: array<Record>,
        buffer: buffer<Record>,
        nested: Event
    ) -> i32;
    sync fn inspect_scalar_collections(
        array: array<i32>,
        buffer: buffer<i32>
    ) -> i32;

    sync fn return_string() -> string;
    sync fn return_struct() -> Record;
    sync fn return_enum() -> Event;
    sync fn return_option() -> Option<Record>;
    sync fn return_result() -> Result<Record, Event>;
    sync fn return_array() -> array<i32>;
    sync fn return_buffer() -> buffer<i32>;
    sync fn return_array_struct() -> array<Record>;
    sync fn return_buffer_struct() -> buffer<Record>;
    sync fn return_nested_enum() -> Event;
    sync fn return_option_array() -> Option<array<Record>>;
    sync fn return_result_buffer() -> Result<buffer<Record>, Event>;
    sync fn return_large_array() -> array<i32>;
    sync fn return_large_buffer() -> buffer<i32>;
    sync fn return_nested() -> Nested;
    sync fn return_scalar() -> i32;
    sync fn baseline8(
        a: i32, b: i32, c: i32, d: i32,
        e: i32, f: i32, g: i32, h: i32
    ) -> i32;
    sync fn panic_host() -> i32;
}
