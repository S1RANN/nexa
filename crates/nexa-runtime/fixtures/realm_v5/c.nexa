module realm.v5.c;
import host;

@stateful(3) class ModelState {
    value: i32;
    replacement: i32;
    generation: i32;
}

cleanup fn finalize(value: i32) -> i32 {
    return value;
}

task fn normal(value: i32) -> i32 {
    defer finalize(value);
    return value;
}

task fn fuel(value: i32) -> i32 {
    defer finalize(value);
    for index in 0..32 {
        value + index;
    }
    return value;
}

task fn explicit(value: i32) -> i32 {
    defer finalize(value);
    yield;
    return value;
}

task fn request(value: i32) -> Result<i32, WaitError> {
    defer finalize(value);
    for index in 0..8 {
        value + index;
    }
    yield;
    let completed: i32 = await host.wait(value)?;
    return Ok(completed);
}

migration fn migrate() -> bool {
    let old_state: ModelState = old.get<ModelState>(seed);
    let value: i32 = old.field<i32>(old_state, ModelState.value);
    let replacement: i32 = old.field<i32>(old_state, ModelState.replacement);
    let next: ModelState = new.create<ModelState>(seed);
    new.set(next, ModelState.value, value);
    new.set(next, ModelState.replacement, replacement);
    new.set(next, ModelState.generation, 3);
    replace(seed, next);
    finish_migration();
    return true;
}

@activation fn activate(fail: bool) -> bool {
    if fail {
        let trapped: i32 = 1 / 0;
    }
    return true;
}
