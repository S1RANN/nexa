module realm.v5.b;
import host as fixture_host;

@stateful(2) class ModelState {
    value: i32;
    replacement: i32;
}

pub cleanup fn finalize(value: i32) -> i32 {
    return value;
}

task fn normal(value: i32) -> i32 {
    defer finalize(value);
    return value;
}

task fn fuel(value: i32) -> i32 {
    defer finalize(value);
    for index in 0..32 {
        value + index;
    }
    return value;
}

task fn explicit(value: i32) -> i32 {
    defer finalize(value);
    yield;
    return value;
}

task fn request(value: i32) -> Result<i32, fixture_host.WaitError> {
    defer finalize(value);
    for index in 0..8 {
        value + index;
    }
    yield;
    let completed: i32 = await fixture_host.wait(value)?;
    return Ok(completed);
}

pub migration fn migrate(exercise_graph: bool) -> bool {
    if exercise_graph {
        let old_state: ModelState = old.get<ModelState>(boss);
        let value: i32 = old.field<i32>(old_state, ModelState.value);
        let replacement: ModelState = new.create<ModelState>(boss);
        new.set(replacement, ModelState.value, value);
        new.set(replacement, ModelState.replacement, 1);
        preserve(preserved);
        replace(boss, replacement);
        delete(deleted);
    }
    let bootstrap: ModelState = new.create<ModelState>(seed);
    new.set(bootstrap, ModelState.value, 1);
    new.set(bootstrap, ModelState.replacement, 2);
    finish_migration();
    return true;
}

@activation pub fn activate(fail: bool) -> bool {
    if fail {
        let trapped: i32 = 1 / 0;
    }
    return true;
}
