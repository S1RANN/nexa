
@state(version = 4)
class ModelState {
    value: i32,
    replacement: i32,
    generation: i32,
    final_value: i32,
}

@cleanup
pub fn finalize(value: i32) -> i32 {
    return value;
}

pub async fn normal(value: i32) -> i32 {
    defer finalize(value);
    return value;
}

pub async fn fuel(value: i32) -> i32 {
    defer finalize(value);
    for index in 0..32 {
        value + index;
    }
    return value;
}

pub async fn explicit(value: i32) -> i32 {
    defer finalize(value);
    yield;
    return value;
}

pub async fn request(value: i32) -> Result<i32, host::WaitError> {
    defer finalize(value);
    for index in 0..8 {
        value + index;
    }
    yield;
    let completed: i32 = host::wait(value).await?;
    return Result::Ok(completed);
}

@migration
pub fn migrate() -> bool {
    let old_state: ModelState = old.get<ModelState>(seed);
    let value: i32 = old.field<i32>(old_state, ModelState::value);
    let replacement: i32 = old.field<i32>(old_state, ModelState::replacement);
    let generation: i32 = old.field<i32>(old_state, ModelState::generation);
    let next: ModelState = new.create<ModelState>(seed);
    new.set(next, ModelState::value, value);
    new.set(next, ModelState::replacement, replacement);
    new.set(next, ModelState::generation, generation);
    new.set(next, ModelState::final_value, 4);
    replace(seed, next);
    finish_migration();
    return true;
}

@activation
pub fn activate(fail: bool) -> bool {
    if fail {
        let trapped: i32 = 1 / 0;
    }
    return true;
}
